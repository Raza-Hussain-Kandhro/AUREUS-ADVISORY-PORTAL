# Server port
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Optional — omit to run the API in mock-data mode with zero setup.
# MongoDB example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/aureus
MONGODB_URI=

# Secret used to sign login sessions (JWTs). Required for real deployments —
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
